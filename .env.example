# ---------------------------------------------------------------------------
# Arena Live OS — ortam değişkenleri
# Kopyalayın:  copy .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL bağlantısı (zorunlu)
DATABASE_URL=postgresql://postgres:SIFRE@127.0.0.1:5432/app_db

# Panel sunucu portu
PORT=3000

# GitHub web paneli / Windows paketi veri kaynağı (GitHub Pages)
# Depo adınız: https://<kullanici>.github.io/<depo>
ARENA_BACKEND=https://cehennemgibiyim.github.io/ArenaSol
ARENA_REPO=CehennemGibiyim/ArenaSol
ARENA_BRANCH=main

# Yerel ajan ayarları
# 1 = panel API'sine yaz, 0 = yalnızca GitHub verisini oku
LOCAL_LISTEN=1
# 1 = sandık açılışında canlı yayını otomatik tarayıcıda aç (sandık açma asistanı)
AUTO_JOIN=1
# Otomatik açma için minimum oran (jeton ÷ kontenjan)
AUTO_JOIN_MIN_RATIO=1
# Otomatik açma için minimum jeton
AUTO_JOIN_MIN_COINS=100
# Sandık açılışından kaç saniye önce tarayıcı açılsın
AUTO_JOIN_LEAD_SECONDS=20
# Aynı sandığı iki kez açmamak için bekleme (saniye)
AUTO_JOIN_COOLDOWN_SECONDS=1800
# Ajanın GitHub güncelleme kontrolü aralığı (saniye)
UPDATE_CHECK_SECONDS=1800

# Canlı stüdyo: panel API'si (yerel)
ARENA_PANEL_URL=http://localhost:3000
ARENA_INGEST_TOKEN=

# İzleme listesi (virgülle) — "@a,@b"
WATCHLIST=

# Opsiyonel: bölge keşif feed'i (EulerStream Business)
# Boş bırakılırsa keşif kayıtlı hesaplar + sabitlenenler + açık listeden yapılır.
EULER_API_KEY=

# Opsiyonel: yalnızca WebSocket imza kotası (ücretsiz topluluk anahtarı).
# Boş bırakılsa da dinleme çalışır; anahtar yalnızca bağlantı kotasını yükseltir.
SIGN_API_KEY=

# Opsiyonel: AI koçu
OPENAI_API_KEY=
